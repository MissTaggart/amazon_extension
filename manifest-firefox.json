{
  "manifest_version": 3,
  "name": "Amazon Order Tracker",
  "version": "1.0.1",
  "description": "Displays Amazon orders with tracking numbers and delivery dates",
  "browser_specific_settings": {
    "gecko": {
      "id": "amazon-order-tracker@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/gp/css/order-history*",
        "https://www.amazon.com/gp/your-account/order-history*",
        "https://www.amazon.com/your-orders/*",
        "https://www.amazon.co.uk/gp/css/order-history*",
        "https://www.amazon.co.uk/gp/your-account/order-history*",
        "https://www.amazon.co.uk/your-orders/*"
      ],
      "js": ["content.js"]
    }
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
